---
import Search from './Search.astro';
---

<header
  class="bg-canvas/85 sticky top-0 z-40 border-b border-slate-200/70 backdrop-blur-md dark:border-slate-800/70"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6">
    <a href="/" class="tap-press flex shrink-0 items-center gap-2 no-underline" aria-label="Aevum Docs home">
      <img src="/brand/logo.svg" alt="" width="28" height="28" class="h-7 w-7" />
      <span class="text-[0.95rem] font-semibold text-slate-900 dark:text-slate-100">
        Aevum <span class="text-slate-400 dark:text-slate-500">Docs</span>
      </span>
    </a>

    <nav class="ml-2 hidden items-center gap-1 text-sm sm:flex" aria-label="Primary">
      <a
        href="/"
        class="rounded-md px-3 py-1.5 font-medium text-slate-600 no-underline hover:bg-slate-500/10 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100"
        >Docs</a
      >
      <a
        href="/engineering"
        class="rounded-md px-3 py-1.5 font-medium text-slate-600 no-underline hover:bg-slate-500/10 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100"
        >Engineering</a
      >
      <a
        href="/manual"
        class="rounded-md px-3 py-1.5 font-medium text-slate-600 no-underline hover:bg-slate-500/10 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100"
        >Manual</a
      >
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <div class="hidden w-56 md:block lg:w-72">
        <Search variant="nav" />
      </div>

      <div class="relative">
        <button
          id="prefs-btn"
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          aria-label="Theme and accessibility settings"
          class="tap-press focus-visible:ring-accent-500 flex h-9 w-9 items-center justify-center rounded-md border border-slate-300 bg-white text-slate-600 hover:bg-slate-50 focus-visible:ring-2 focus-visible:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
        >
          {/* sliders icon */}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line>
          </svg>
        </button>

        <div
          id="prefs-panel"
          hidden
          role="menu"
          class="absolute right-0 z-50 mt-2 w-64 rounded-lg border border-slate-200 bg-white p-3 shadow-xl dark:border-slate-700 dark:bg-slate-900"
        >
          <p class="mb-1.5 text-xs font-semibold tracking-wider text-slate-500 uppercase dark:text-slate-400">Theme</p>
          <div class="mb-3 inline-flex w-full items-center gap-1 rounded-md bg-slate-100 p-1 dark:bg-slate-800">
            {
              [
                ['light', 'Light'],
                ['dark', 'Dark'],
                ['system', 'System'],
              ].map(([mode, label]) => (
                <button
                  type="button"
                  data-theme={mode}
                  aria-pressed="false"
                  class="tap-press flex-1 rounded px-2 py-1.5 text-xs font-medium text-slate-600 aria-pressed:bg-white aria-pressed:text-slate-900 aria-pressed:shadow-sm dark:text-slate-300 dark:aria-pressed:bg-slate-700 dark:aria-pressed:text-slate-100"
                >
                  {label}
                </button>
              ))
            }
          </div>

          <p class="mb-1.5 text-xs font-semibold tracking-wider text-slate-500 uppercase dark:text-slate-400">Accessibility</p>
          <div class="space-y-1.5 text-sm text-slate-700 dark:text-slate-300">
            {
              [
                ['reduceMotion', 'Reduce motion'],
                ['highContrast', 'High contrast'],
                ['underlineLinks', 'Underline links'],
                ['focusAlways', 'Always show focus'],
              ].map(([key, label]) => (
                <label class="flex cursor-pointer items-center justify-between gap-3 rounded px-1 py-1 hover:bg-slate-500/5">
                  <span>{label}</span>
                  <input
                    type="checkbox"
                    data-a11y={key}
                    class="accent-accent-600 h-4 w-4 cursor-pointer"
                  />
                </label>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import '../scripts/prefs.ts';
</script>
