---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocShell from '../../components/DocShell.astro';
import { buildEngGroups } from '../../lib/eng.mjs';
import { engDocForEntry } from '../../lib/docs-map.mjs';

export async function getStaticPaths() {
  // The glob may load more than we publish; the docs-map contract is the authority.
  // Keep only loaded entries that map to a contract doc, and route them at its id.
  const entries = await getCollection('engineering');
  return entries
    .map((entry) => ({ entry, doc: engDocForEntry(entry) }))
    .filter(({ doc }) => doc)
    .map(({ entry, doc }) => ({ params: { slug: doc.id }, props: { entry, doc } }));
}

const { entry, doc } = Astro.props;
const { Content, headings } = await render(entry);
const title = doc.title;
const groups = buildEngGroups(doc.source);
---

<Base title={title} description={`Engineering documentation — ${title}.`} bare>
  <DocShell groups={groups} headings={headings} navLabel="Engineering docs">
    <p class="not-prose mb-4 text-xs font-medium tracking-wider text-slate-400 uppercase dark:text-slate-500">
      Engineering
    </p>
    <Content />
  </DocShell>
</Base>
